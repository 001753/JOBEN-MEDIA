# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build outputs ──────────────────────────────────────────────
# build/ (Strapi admin) dan frontend/next-build.tar.gz di-commit ke git.
# frontend/.next/ di-ignore — di-pack ke next-build.tar.gz oleh build-all.sh.
# deploy.sh di cPanel mengekstrak next-build.tar.gz → frontend/.next/ saat deploy.
# Lihat doc/CPANEL_DEPLOY_CHECKLIST.md §5.
dist/
.strapi/
.cache/
# frontend/.next/ — di-pack ke next-build.tar.gz, TIDAK di-commit langsung
frontend/.next/
# next-build.tar.gz — JANGAN ignore! Ini adalah build artifact yang di-commit
# !frontend/next-build.tar.gz  ← tidak perlu karena .next/ saja yang di-ignore

# ── Environment variables — JANGAN commit ke GitHub ───────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.development
# .env.example BOLEH di-commit (tidak ada nilai sensitif)

# ── Database lokal (SQLite dev) ───────────────────────────────
.tmp/
*.db
*.sqlite

# ── Upload lokal (media di Cloudflare R2, bukan di repo) ─────
public/uploads/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
._*

# ── Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Replit (tidak perlu di repo GitHub) ───────────────────────
.replit
replit.nix
.upm/
.config/
